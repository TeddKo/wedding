---
import Base from "../layouts/Base.astro";
import Intro from "../components/Intro.astro";
import Cover from "../components/Cover.astro";
import Greeting from "../components/Greeting.astro";
import Location from "../components/Location.astro";
import Gallery from "../components/Gallery.astro";
import Snapshots from "../components/Snapshots.astro";
import Poll from "../components/Poll.astro";
import Guestbook from "../components/Guestbook.astro";
import Accounts from "../components/Accounts.astro";
import Rsvp from "../components/Rsvp.astro";
import Ending from "../components/Ending.astro";
import Reveal from "../components/Reveal.svelte";
import Fx from "../components/fx/Fx.svelte";
import Orn from "../components/Orn.astro";
import { hasMusic } from "../lib/music";
---

<Base>
  <Intro />
  <main class="page">
    <Cover />
    <Greeting />
    <Orn />
    <Gallery />
    <Snapshots />
    <Location />
    <Accounts />
    <Rsvp />
    <Poll />
    <Guestbook />
    <Orn />
    <Ending hasMusic={hasMusic} />
  </main>
  <Reveal client:idle />
  <Fx client:idle />
</Base>
