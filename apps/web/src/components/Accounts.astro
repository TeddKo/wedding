---
import { fnv7 } from "../lib/hash";
import HDeco from "./art/halloween/Deco.svelte";
import AccountGroups from "./AccountGroups.svelte";
import { wedding } from "../data/wedding";
import { accountRows } from "../lib/family";

const groups = [
  { title: "신랑 측", rows: accountRows("groom", wedding.groom, wedding.accounts.groom) },
  { title: "신부 측", rows: accountRows("bride", wedding.bride, wedding.accounts.bride) },
].filter((g) => g.rows.length > 0);
---

{
  groups.length > 0 && (
    <section class="section acc-sec" data-reveal aria-labelledby="acc-h">
      <p class="eyebrow" data-rv="fade">ACCOUNT</p>
      <HDeco kind="lantern" />
      <h2 class="sec-title" id="acc-h" data-rv="mask" style="--d:120ms"><span class="hash" data-th="dev" aria-hidden="true">{fnv7("accounts")}</span>마음 전하실 곳</h2>
      <p class="body-copy" data-rv="lines" style="--d:320ms">
        직접 축하를 전하기 어려우신 분들을 위해
        <br />
        계좌번호를 함께 안내드립니다.
        <br />
        보내주시는 따뜻한 마음, 감사히 간직하겠습니다.
      </p>
      <AccountGroups client:load groups={groups} />
    </section>
  )
}

<style>
  .acc-sec { text-align: center; }
  .acc-sec .body-copy { margin: 20px 0 28px; }
</style>
