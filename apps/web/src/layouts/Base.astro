---
import "../styles/global.css";
import "../styles/motion.css";
import "../styles/th/halloween.css";
import "../styles/th/puppy.css";
import "../styles/th/dev.css";
import "../styles/th/dev-rail.css";
import { hasMusic } from "../lib/music";
import { wedding } from "../data/wedding";
import { dateKo } from "../lib/format";
import { url } from "../lib/url";
import ThemeSwitch from "../components/ThemeSwitch.svelte";
import { THEMES, THEME_NAMES } from "../lib/themes";
import { ICONS } from "../lib/icons";

const pageUrl = new URL(url(""), Astro.site).href;
const ogImage = new URL(url("og.jpg"), Astro.site).href;
const title = wedding.share.title;
const desc = `${dateKo} ${wedding.venue.name}`;
const colors = Object.fromEntries(THEME_NAMES.map((k) => [k, THEMES[k].color]));
---

<!doctype html>
<html lang="ko" data-theme={wedding.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={THEMES[wedding.theme].color} />
    <script is:inline define:vars={{ colors }}>
      try {
        var q = new URLSearchParams(location.search).get("theme");
        var has = function (k) { return !!k && Object.prototype.hasOwnProperty.call(colors, k); };
        var t = has(q) ? q : localStorage.getItem("theme");
        if (has(t)) {
          document.documentElement.dataset.theme = t;
          document.querySelector('meta[name="theme-color"]').content = colors[t];
          if (q === t) localStorage.setItem("theme", t);
        }
      } catch (e) {}
      /* 카카오 로그인에서 돌아온 경우(?state=poll-…&code|error) 인트로 게이트 없이 바로 본문 열기 */
      var back = /[?&]state=poll-/.test(location.search) && /[?&](code|error)=/.test(location.search);
      document.documentElement.classList.add("has-js");
      if (!back) document.documentElement.classList.add("js", "gated");
      setTimeout(function () {
        var h = document.documentElement;
        if (h.dataset.gate !== "ready") h.classList.remove("js", "gated");
      }, 4500);
    </script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Gowun+Dodum&family=Cormorant+Garamond:ital,wght@0,400;1,300&family=Fraunces:wght@300&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body
    data-bgm={hasMusic ? url("audio/bgm.mp3") : ""}
  >
    <slot />
    <div class="fabs" id="dock">
      {THEME_NAMES.length > 1 && <ThemeSwitch client:idle />}
      <button type="button" class="fab bgm-toggle" id="bgm-toggle" aria-label="배경음악 켜기" aria-pressed="false" hidden>
        <svg class="ic-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5Z" /></svg>
        <span class="ic-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="bgm-badge" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d={ICONS.music} /></svg></span>
      </button>
    </div>
    <button type="button" class="to-top" id="to-top" aria-label="맨 위로" tabindex="-1">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" /></svg>
      <span>맨 위로</span>
    </button>
    <script>
      const root = document.documentElement;
      /* 맨 아래 근처에서만 표시되는 맨 위로 버튼 */
      const top = document.getElementById("to-top") as HTMLButtonElement;
      top.addEventListener("click", () => {
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
        scrollTo({ top: 0, behavior: still ? "auto" : "smooth" });
        const main = document.querySelector<HTMLElement>("main");
        main?.setAttribute("tabindex", "-1");
        main?.focus({ preventScroll: true });
      });
      let q = 0;
      const sync = () => {
        q = 0;
        const y = scrollY;
        const end = y > innerHeight && y + innerHeight >= document.documentElement.scrollHeight - 160;
        root.classList.toggle("at-end", end);
        top.tabIndex = end ? 0 : -1;
      };
      addEventListener("scroll", () => (q ||= requestAnimationFrame(sync)), { passive: true });
      sync();
    </script>
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
