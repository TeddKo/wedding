---
import { wedding } from "../data/wedding";

interface Props {
  hasMusic: boolean;
}
const { hasMusic } = Astro.props;
---

<footer class="footer" data-reveal="rise">
  <p class="latin">{wedding.groom} &amp; {wedding.bride} · {wedding.date.replaceAll("-", ".")}</p>
  <p class="credits">Made by TeddKo{hasMusic ? ` · ${wedding.musicCredit}` : ""}</p>
</footer>
