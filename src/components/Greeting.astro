---
import { fnv7 } from "../lib/hash";
import { wedding } from "../data/wedding";
import { givenName, hasParents } from "../lib/family";

const families = [wedding.groom, wedding.bride].filter(hasParents);
---

<section class="section" data-reveal aria-labelledby="greeting-h">
  <h2 id="greeting-h" class="sec-title"><span class="hash" data-th="dev" aria-hidden="true">{fnv7("greeting")}</span>{wedding.greeting.title}</h2>
  <div class="greeting">
    {wedding.greeting.body.map((p) => <p>{p}</p>)}
  </div>
  {
    families.length > 0 && (
      <div class="family">
        {families.map((p) => {
          const parents = [p.father, p.mother].filter((x) => x.name);
          return (
            <p>
              {parents.map((x, i) => (
                <>
                  {i > 0 && <span class="sep" aria-hidden="true"></span>}
                  <span class="par">{x.deceased && <span class="dec">故</span>}{x.name}</span>
                </>
              ))}
              <span class="of">의</span> {p.relation} <b>{givenName(p)}</b>
            </p>
          );
        })}
      </div>
    )
  }
  <p class="signature">신랑 <b>{wedding.groom.name}</b><span class="sep" aria-hidden="true"></span>신부 <b>{wedding.bride.name}</b></p>
</section>
