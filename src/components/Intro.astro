---
import Ornament from "./Ornament.astro";
import { wedding } from "../data/wedding";
---

<div class="intro" id="intro">
  <div class="door door-l"></div>
  <div class="door door-r"></div>
  <div class="intro-bats" aria-hidden="true">
    <span class="bat b1"><Ornament name="bat" /></span>
    <span class="bat b2"><Ornament name="bat" /></span>
    <span class="bat b3"><Ornament name="bat" /></span>
    <span class="bat b4"><Ornament name="bat" /></span>
  </div>
  <div class="moon-wrap"><Ornament name="moon" /></div>
  <button type="button" class="intro-open" id="intro-open">
    <span class="latin">The Wedding · Hallow's Eve</span>
    <span class="intro-names">{wedding.groom} · {wedding.bride}</span>
    <span class="intro-cta">초대장 열기</span>
  </button>
</div>
<noscript><style>.intro{display:none!important}</style></noscript>
