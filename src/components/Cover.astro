---
import { Image } from "astro:assets";
import CoverHero from "./CoverHero.svelte";
import { wedding } from "../data/wedding";
import { dateKo, venueLine } from "../lib/format";
import { photos } from "../lib/photos";

const cover = photos[0];
---

<CoverHero client:load groom={wedding.groom.name} bride={wedding.bride.name} dateKo={dateKo} venue={venueLine} hasPhoto={!!cover}>
  {
    cover && (
      <Image slot="photo" src={cover} alt={`${wedding.groom.name}, ${wedding.bride.name}`} width={720} format="webp" widths={[360, 540, 720]} sizes="(max-width: 480px) 80vw, 384px" loading="eager" />
    )
  }
</CoverHero>
