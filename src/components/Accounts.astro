---
import { fnv7 } from "../lib/hash";
import AccountGroups from "./AccountGroups.svelte";
import { wedding } from "../data/wedding";
import { accountRows } from "../lib/family";

const groups = [
  { title: "신랑 측", rows: accountRows("groom", wedding.groom, wedding.accounts.groom) },
  { title: "신부 측", rows: accountRows("bride", wedding.bride, wedding.accounts.bride) },
].filter((g) => g.rows.length > 0);
---

{
  groups.length > 0 && (
    <section class="section" data-reveal aria-labelledby="acc-h">
      <h2 id="acc-h" class="sec-title"><span class="hash" data-th="dev" aria-hidden="true">{fnv7("accounts")}</span>마음 전하실 곳</h2>
      <AccountGroups client:load groups={groups} />
    </section>
  )
}
