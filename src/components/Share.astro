---
import Ornament from "./Ornament.astro";
---

<section class="section" data-reveal="rise" aria-labelledby="share-h">
  <h2 id="share-h" class="sec-title"><span class="latin">Share</span>공유하기</h2>
  <Ornament name="divider" />
  <div class="share-row">
    <button type="button" class="btn" id="kakao-share" hidden>카카오톡 공유</button>
    <button type="button" class="btn btn-ghost" data-copy-url>링크 복사</button>
  </div>
</section>
