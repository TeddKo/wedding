---
import { fnv7 } from "../lib/hash";
import ActionButtons from "./ActionButtons.svelte";
import { wedding } from "../data/wedding";
import { url } from "../lib/url";

const pageUrl = new URL(url(""), Astro.site).href;
const imageUrl = new URL(url("og.png"), Astro.site).href;
---

<section class="section" data-reveal aria-labelledby="share-h">
  <h2 id="share-h" class="sec-title"><span class="hash" data-th="dev" aria-hidden="true">{fnv7("share")}</span>공유하기</h2>
  <div class="btn-row">
    <ActionButtons
      client:idle
      actions={[
        { kind: "kakao", label: "카카오톡 공유" },
        { kind: "copy", label: "링크 복사", text: pageUrl, ghost: true },
      ]}
      kakao={{ key: wedding.kakaoJsKey, title: wedding.share.title, description: wedding.share.description, imageUrl, pageUrl }}
    />
  </div>
</section>
