---
import { wedding } from "../data/wedding";
import ActionButtons from "./ActionButtons.svelte";
import KakaoMap from "./KakaoMap.svelte";
import MapChooser from "./MapChooser.svelte";
import { venueLine } from "../lib/format";
import { mapApps } from "../lib/maps";
import { fnv7 } from "../lib/hash";
import { ICONS, type IconName } from "../lib/icons";

const { name, mapQuery: query, lat, lng, transit } = wedding.venue;
const venue = { name, query, lat, lng };
const webLinks = mapApps("desktop", false, venue);

const all: { icon: IconName; label: string; lines: string[] }[] = [
  { icon: "subway", label: "지하철", lines: transit.subway ?? [] },
  { icon: "bus", label: "버스", lines: transit.bus ?? [] },
  { icon: "car", label: "자가용", lines: transit.car ? [transit.car] : [] },
  { icon: "parking", label: "주차", lines: transit.parking ? [transit.parking] : [] },
];
const rows = all.filter((r) => r.lines.length > 0);
---

<section class="section" data-reveal aria-labelledby="loc-h">
  <h2 id="loc-h" class="sec-title"><span class="hash" data-th="dev" aria-hidden="true">{fnv7("location")}</span>오시는 길</h2>
  <KakaoMap client:visible name={name} address={wedding.venue.address} lat={lat} lng={lng} appkey={wedding.kakaoJsKey} />
  <p class="venue-name">{venueLine}</p>
  <p class="address" id="address">{wedding.venue.address}</p>
  <div class="btn-row">
    <MapChooser client:visible venue={venue} />
    <ActionButtons client:idle actions={[{ kind: "copy", label: "주소 복사", text: wedding.venue.address, ghost: true }]} />
  </div>
  <div class="map-fallback">
    {webLinks.map((a) => <a class="btn-text" href={a.href} target="_blank" rel="noopener noreferrer">{a.name}</a>)}
  </div>
  {
    rows.length > 0 && (
      <dl class="transit">
        {rows.map((r) => (
          <div>
            <dt>
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ICONS[r.icon]} /></svg>
              {r.label}
            </dt>
            <dd>{r.lines.map((l) => <span>{l}</span>)}</dd>
          </div>
        ))}
      </dl>
    )
  }
</section>
