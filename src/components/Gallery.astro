---
import { getImage } from "astro:assets";
import Ornament from "./Ornament.astro";
import GalleryIsland from "./Gallery.svelte";
import { photos } from "../lib/photos";

const items = await Promise.all(
  photos.map(async (src) => {
    const [a, b, c] = await Promise.all([180, 360, 540].map((width) => getImage({ src, width, height: width, format: "webp" })));
    const full = await getImage({ src, width: 1400, format: "webp" });
    return {
      thumb: b.src,
      srcset: `${a.src} 180w, ${b.src} 360w, ${c.src} 540w`,
      full: full.src,
      w: Number(full.attributes.width ?? src.width),
      h: Number(full.attributes.height ?? src.height),
    };
  }),
);
---

<section class="section" data-reveal="rise" aria-labelledby="gal-h">
  <h2 id="gal-h" class="sec-title"><span class="latin">Gallery</span>갤러리</h2>
  <Ornament name="divider" />
  <GalleryIsland client:idle items={items} count={9} />
</section>
