---
import ActionButtons from "./ActionButtons.svelte";
import PuppyEndArt from "./art/puppy/EndArt.svelte";
import HalloweenEndArt from "./art/halloween/EndArt.svelte";
import { wedding } from "../data/wedding";
import { url } from "../lib/url";

interface Props {
  hasMusic: boolean;
}
const { hasMusic } = Astro.props;

const pageUrl = new URL(url(""), Astro.site).href;
const imageUrl = new URL(url("og.jpg"), Astro.site).href;
const [Y, M, D] = wedding.date.split("-").map(Number);
const [H, MIN] = wedding.time.split(":").map(Number);
const wd = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"][new Date(Date.UTC(Y, M - 1, D)).getUTCDay()];
const dateText = `${Y}. ${M}. ${D} ${wd}`;
const timeText = `${H < 12 ? "AM" : "PM"} ${H % 12 || 12}:${String(MIN).padStart(2, "0")}`;
---

<footer class="footer ending" data-reveal>
  <div class="end-art-h" data-th="halloween" data-rv="rise" style="--d:0ms"><HalloweenEndArt /></div>
  <p class="script" data-th="halloween" data-rv="mask" data-dir="x" style="--d:300ms">till death do us part</p>
  <p class="script" data-th="dev" data-rv="mask" data-dir="x" style="--d:300ms">Save the Date</p>
  <p class="script" data-th="puppy" data-rv="mask" data-dir="x" style="--d:300ms">made for each other</p>
  <i class="rule ink" aria-hidden="true" data-rv="draw" style="--d:1300ms"></i>
  <dl class="meta">
    <div><dt data-rv="fade" style="--d:1450ms">DATE</dt><dd data-rv="count" style="--d:1500ms">{dateText}</dd></div>
    <div><dt data-rv="fade" style="--d:1450ms">TIME</dt><dd data-rv="count" style="--d:1500ms">{timeText}</dd></div>
  </dl>
  <i class="rule" aria-hidden="true"></i>
  <p class="addr" data-rv="fade" style="--d:1700ms">{wedding.venue.address}</p>
  <div class="end-art" data-th="puppy" data-rv="rise" style="--d:1800ms"><PuppyEndArt /></div>
  <p class="thanks" data-rv="lines" style="--d:1850ms">함께해 주셔서 고맙습니다.</p>
  <div class="share">
    <ActionButtons
      client:idle
      actions={[
        { kind: "kakao", label: "카카오톡 공유하기", rise: 2000 },
        { kind: "copy", label: "링크 복사", text: pageUrl, ghost: true, rise: 2090 },
      ]}
      kakao={{ key: wedding.kakaoJsKey, title: wedding.share.title, description: wedding.share.description, imageUrl, pageUrl }}
    />
  </div>
  <p class="credits">
    <span>© Made by TeddKo</span>
    {hasMusic && <span>{wedding.musicCredit}</span>}
  </p>
</footer>

<style>
  .footer.ending { max-width: 440px; margin: 0 auto; padding: 60px 40px 112px; text-align: center; display: block; }
  .script { font: italic 300 26px/36px var(--f-script, var(--f-latin)); letter-spacing: 0.04em; color: var(--accent-text); margin-bottom: 8px; }
  :global([data-theme="puppy"]) .script { font-style: normal; font-size: 22px; letter-spacing: 0.06em; color: var(--accent-text); }
  :global([data-theme="dev"]) .script { font: 600 22px/32px var(--f-ui); letter-spacing: -0.02em; color: var(--ink); }
  .rule { display: block; height: 1px; margin: 32px 0 0; background: var(--line); }
  .rule.ink { background: color-mix(in srgb, var(--ink-3) 55%, transparent); margin-top: 32px; }
  .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 24px 0 0; padding: 0; }
  .meta dt { font: 400 11px/16px var(--f-latin); letter-spacing: 0.28em; color: var(--ink-3); }
  .meta dd { margin: 4px 0 0; font: 400 16px/24px var(--f-latin); letter-spacing: 0.04em; font-variant-numeric: lining-nums tabular-nums; color: var(--ink); }
  .addr { margin-top: 24px; font: 400 13px/20px var(--f-body); color: var(--ink-2); }
  .thanks { margin-top: 32px; font: 400 var(--t-body)/26px var(--f-body); color: var(--ink-2); }
  .share { margin-top: 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .share:has(button[hidden]) { grid-template-columns: 1fr; }
  .end-art { width: 140px; margin: 32px auto 0; }
  .end-art :global(svg) { display: block; width: 100%; height: auto; }
  .credits { margin-top: 48px; font-size: 11px; letter-spacing: 0.02em; line-height: 1.6; color: var(--ink-3); }
  .credits span { display: block; }
  :global(html[data-theme="dev"] .footer.ending.tag-wait::after) { opacity: 0; }
</style>
