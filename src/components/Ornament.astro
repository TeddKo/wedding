---
import { BAT_PATH } from "../lib/bat";
interface Props {
  name: "moon" | "bat" | "candle" | "cobweb" | "divider";
}
const { name } = Astro.props;
---

{
  name === "moon" && (
    <svg class="orn-moon" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="moonfill" cx="38%" cy="34%" r="75%">
          <stop offset="0" stop-color="#fbf3df" />
          <stop offset="0.7" stop-color="#e9dcc0" />
          <stop offset="1" stop-color="#c9b88f" />
        </radialGradient>
      </defs>
      <circle cx="60" cy="60" r="54" fill="url(#moonfill)" />
      <g fill="#b8a678" opacity="0.45">
        <circle cx="42" cy="44" r="9" />
        <circle cx="76" cy="70" r="12" />
        <circle cx="58" cy="86" r="5" />
        <circle cx="84" cy="38" r="4" />
        <circle cx="34" cy="72" r="4" />
      </g>
    </svg>
  )
}
{
  name === "bat" && (
    <svg class="orn-bat" viewBox="0 0 64 32" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M32 10c1.5 0 2.2 1.4 3 2.6 2.4-1.6 5.6-3.2 9.6-3.6C50 8.4 56 6 62 2c-1.6 4-2 7.4-1 11-2 .2-4 1.2-5 3 .4 1.6.8 3.2 1 5.4-2.6-1.4-5.4-1.8-8-.4-2 1-3.4 3-4.4 5.4C43 22 40 20.6 37.6 22L35 28.4c-.8-1.4-1.6-2.6-3-2.6s-2.2 1.2-3 2.6L26.4 22c-2.4-1.4-5.4 0-8.6 3.4-1-2.4-2.4-4.4-4.4-5.4-2.6-1.4-5.4-1-8 .4.2-2.2.6-3.8 1-5.4-1-1.8-3-2.8-5-3 1-3.6.6-7-1-11 6 4 12 6.4 17.4 6.8 4 .4 7.2 2 9.6 3.6.8-1.2 1.5-2.6 3-2.6Z"
      />
    </svg>
  )
}
{
  name === "candle" && (
    <svg class="orn-candle" viewBox="0 0 40 90" aria-hidden="true" focusable="false">
      <g class="flame">
        <path d="M20 4c5 7 8 12 8 18a8 8 0 0 1-16 0c0-6 3-11 8-18Z" fill="#e07a2f" />
        <path d="M20 12c2.6 4 4 7 4 10a4 4 0 0 1-8 0c0-3 1.4-6 4-10Z" fill="#f6d27a" />
      </g>
      <rect x="19.4" y="28" width="1.2" height="6" fill="#3a2e3f" />
      <path d="M11 36h18v46a3 3 0 0 1-3 3H14a3 3 0 0 1-3-3V36Z" fill="#f2e8d5" />
      <path d="M11 36h18l-1 6c-2 2-4 0-6 2s-4 0-6 0-3-2-5-2l-0-6Z" fill="#fffaf0" opacity="0.6" />
    </svg>
  )
}
{
  name === "cobweb" && (
    <svg class="orn-cobweb" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round">
        <path d="M0 0 L120 0 M0 0 L0 120 M0 0 L104 62 M0 0 L62 104 M0 0 L116 28 M0 0 L28 116" />
        <path d="M24 0 Q20 20 0 24 M48 0 Q42 42 0 48 M72 0 Q64 64 0 72 M96 0 Q86 86 0 96" />
      </g>
    </svg>
  )
}
{
  name === "divider" && (
    <svg class="orn-divider" viewBox="0 0 240 24" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
        <path d="M4 12H92" pathLength="1" />
        <path d="M236 12H148" pathLength="1" />
        <path d="M92 12c8 0 10-8 18-8m-18 8c8 0 10 8 18 8m-18-8h8" pathLength="1" />
        <path d="M148 12c-8 0-10-8-18-8m18 8c-8 0-10 8-18 8m18-8h-8" pathLength="1" />
      </g>
      <path data-th="halloween" transform="translate(104 4) scale(0.5)" fill="currentColor" d={BAT_PATH} />
      <text data-th="dev" x="120" y="16" text-anchor="middle" font-size="11" font-family="JetBrains Mono, ui-monospace, Menlo, monospace" fill="currentColor">&lt;/&gt;</text>
      <g data-th="puppy" fill="currentColor" transform="translate(120 12) scale(0.55)"><ellipse cx="0" cy="6" rx="8" ry="7" /><circle cx="-9" cy="-4" r="3.4" /><circle cx="-3" cy="-9" r="3.4" /><circle cx="3" cy="-9" r="3.4" /><circle cx="9" cy="-4" r="3.4" /></g>
    </svg>
  )
}
