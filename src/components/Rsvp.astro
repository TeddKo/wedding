---
import { fnv7 } from "../lib/hash";
import { wedding } from "../data/wedding";
---

{
  wedding.rsvpUrl && (
    <section class="section rsvp" data-reveal aria-labelledby="rsvp-h">
      <p class="eyebrow">R.S.V.P.</p>
      <h2 class="sec-title" id="rsvp-h"><span class="hash" data-th="dev" aria-hidden="true">{fnv7("rsvp")}</span>참석 의사 전달</h2>
      <p class="body-copy">
        신랑, 신부에게 참석의사를
        <br />
        미리 전달할 수 있어요.
      </p>
      <a class="btn btn-outline" href={wedding.rsvpUrl} target="_blank" rel="noopener noreferrer">참석 의사 전달하기</a>
    </section>
  )
}

<style>
  .rsvp { text-align: center; }
  .rsvp .body-copy { margin: 20px 0 28px; }
  .rsvp a {
    display: inline-flex; align-items: center; justify-content: center; width: 100%; height: 52px; box-sizing: border-box; border: 1px solid var(--ink); border-radius: 8px;
    background: transparent; color: var(--ink); text-decoration: none; font: 400 14.5px/1 var(--f-ui, inherit);
  }
  .rsvp a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
