---
import { fnv7 } from "../lib/hash";
import { wedding } from "../data/wedding";
---

{
  wedding.rsvpUrl && (
    <section class="section" data-reveal aria-labelledby="rsvp-h">
      <h2 id="rsvp-h" class="sec-title"><span class="hash" data-th="dev" aria-hidden="true">{fnv7("rsvp")}</span>참석 여부</h2>
      <p class="note">참석 여부를 미리 알려주시면 큰 도움이 됩니다.</p>
      <a class="btn-primary" href={wedding.rsvpUrl} target="_blank" rel="noopener noreferrer">참석 여부 전달하기</a>
    </section>
  )
}
