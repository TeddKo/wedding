---
import { fnv7 } from "../lib/hash";
import HDeco from "./art/halloween/Deco.svelte";
import SnapshotsIsland from "./Snapshots.svelte";
import { wedding } from "../data/wedding";
---

{
  wedding.snapshotsApi && (
    <section class="section snap-section" data-reveal aria-labelledby="snap-h">
      <p class="eyebrow" data-rv="fade">SNAPSHOT</p>
      <HDeco kind="bat" />
      <h2 class="sec-title" id="snap-h" tabindex="-1" data-rv="mask" style="--d:120ms"><span class="hash" data-th="dev" aria-hidden="true">{fnv7("snapshot")}</span>하객 스냅샷</h2>
      <p class="body-copy" data-rv="lines" style="--d:320ms">
        예식 날 담아 주신
        <br />
        두 사람의 모습을 나눠 주세요.
      </p>
      <SnapshotsIsland client:visible api={wedding.snapshotsApi} />
      <noscript><p class="cap">스냅샷은 JavaScript가 켜진 브라우저에서 볼 수 있어요</p></noscript>
    </section>
  )
}

<style>
  .snap-section { text-align: center; }
  .snap-section .body-copy { margin: 20px 0 28px; }
  #snap-h { scroll-margin-top: 24px; outline: none; }
</style>
