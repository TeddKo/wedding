---
import "../styles/global.css";
import { hasMusic } from "../lib/music";
import { wedding } from "../data/wedding";
import { dateKo } from "../lib/format";
import { url } from "../lib/url";
import AmbientCanvas from "../components/AmbientCanvas.svelte";
import ThemeSwitch from "../components/ThemeSwitch.svelte";
import { THEMES } from "../lib/themes";
import { ICONS } from "../lib/icons";

const pageUrl = new URL(url(""), Astro.site).href;
const ogImage = new URL(url("og.png"), Astro.site).href;
const title = wedding.share.title;
const desc = `${dateKo} ${wedding.venue.name}`;
const colors = Object.fromEntries(Object.entries(THEMES).map(([k, v]) => [k, v.color]));
---

<!doctype html>
<html lang="ko" data-theme={wedding.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={THEMES[wedding.theme].color} />
    <script is:inline define:vars={{ colors }}>
      try {
        var q = new URLSearchParams(location.search).get("theme");
        var has = function (k) { return !!k && Object.prototype.hasOwnProperty.call(colors, k); };
        var t = has(q) ? q : localStorage.getItem("theme");
        if (has(t)) {
          document.documentElement.dataset.theme = t;
          document.querySelector('meta[name="theme-color"]').content = colors[t];
          if (q === t) localStorage.setItem("theme", t);
        }
      } catch (e) {}
      document.documentElement.classList.add("js", "gated", "has-js");
      setTimeout(function () {
        var h = document.documentElement;
        if (h.dataset.gate !== "ready") h.classList.remove("js", "gated");
      }, 4500);
    </script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Song+Myung&family=Gowun+Batang:wght@400;700&family=IM+Fell+English:ital@0;1&family=IBM+Plex+Sans+KR:wght@400;600&family=IBM+Plex+Mono:wght@400;500&family=Jua&family=Gowun+Dodum&display=swap"
    />
  </head>
  <body
    data-bgm={hasMusic ? url("audio/bgm.mp3") : ""}
  >
    <AmbientCanvas client:idle />
    <slot />
    <div class="dock" id="dock">
      <ThemeSwitch client:idle />
      <button type="button" class="bgm-toggle" id="bgm-toggle" aria-label="배경음악 켜기" aria-pressed="false" hidden>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ICONS.music} /></svg>
      </button>
    </div>
    <script>
      const root = document.documentElement;
      const sync = () => root.classList.toggle("dock-on", scrollY > innerHeight * 0.8);
      addEventListener("scroll", sync, { passive: true });
      sync();
    </script>
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
