---
import "../styles/global.css";
import { hasMusic } from "../lib/music";
import { wedding } from "../data/wedding";
import { dateKo } from "../lib/format";
import { url } from "../lib/url";

const pageUrl = new URL(url(""), Astro.site).href;
const ogImage = new URL(url("og.png"), Astro.site).href;
const title = wedding.share.title;
const desc = `${dateKo} · ${wedding.venue.name}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#120d16" />
    <script is:inline>
      document.documentElement.classList.add("js", "gated");
      setTimeout(function () {
        var h = document.documentElement;
        if (h.dataset.gate !== "ready") h.classList.remove("js", "gated");
      }, 4500);
    </script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Gowun+Batang:wght@400;700&display=swap"
    />
  </head>
  <body
    data-bgm={hasMusic ? url("audio/bgm.mp3") : ""}
  >
    <slot />
    <button type="button" class="bgm-toggle" id="bgm-toggle" aria-label="배경음악 켜기" aria-pressed="false" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9 18V6l10-2v12.2a3 3 0 1 1-2-2.8V7.3L11 8.4V18a3 3 0 1 1-2-2.8z" /></svg>
    </button>
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
